# ---------------------------------------------------------------------
# 一、运行模式
# ---------------------------------------------------------------------
# 语音识别 / 合成 / 大模型使用哪一套服务：
#   demo      无需任何密钥的文本演示模式：不识别麦克风、不合成语音，
#             只能在页面里打字聊天，回复是固定的演示文字。适合先看界面。
#   dashscope 使用阿里云百炼（Paraformer 识别 + Qwen 大模型 + CosyVoice 合成），
#             需要填写下方 DASHSCOPE_API_KEY。
#   local     使用自己部署的本地服务（FunASR 识别 + 本地 OpenAI 兼容大模型
#             + CosyVoice 合成），地址见“七、本地服务”。
PROVIDER=dashscope
# ---------------------------------------------------------------------
# 二、阿里云百炼（PROVIDER=dashscope 时必填）
# ---------------------------------------------------------------------
# 百炼 API Key，在百炼控制台“API-KEY 管理”中创建，形如 sk-xxxx。
# 同时用于语音识别、语音合成和大模型调用。泄露后请立即在控制台作废重建。
DASHSCOPE_API_KEY=sk-ws-H.PPYLLHL.VHVM.MEYCIQDUfw79k0XuJYH8xW31D1_So85x02--iWcNEQNK2OXpUQIhAKZVPLqkvt3K33oPulG4nLmHVcD97IWOY-khwEmVfVLo
# 百炼实时语音（识别 / 合成）WebSocket 地址，一般无需修改。
DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference

# ---------------------------------------------------------------------
# 三、大模型（回答问题 + 可选的语义断句）
# ---------------------------------------------------------------------
# OpenAI 兼容接口地址。dashscope 模式用百炼兼容模式地址；
# local 模式改成本地大模型服务地址（如 vLLM / Ollama 的 http://127.0.0.1:8000/v1）。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 回答问题使用的模型名。qwen-turbo 更快更便宜，qwen-plus 均衡，qwen-max 效果最好但更慢。
LLM_MODEL=qwen-plus

# ---------------------------------------------------------------------
# 四、问答后端（谁来生成回答，独立于语音 Provider）
# ---------------------------------------------------------------------
#   openai  使用上方 LLM_BASE_URL + LLM_MODEL 直接回答（默认）。
#   yuxi    把问题转发给 Yuxi 智能体（可接知识库/业务系统），语音部分仍走 PROVIDER。
# 说明：PROVIDER=demo 时此项不生效，固定为演示回答；
#       使用 yuxi 时会自动关闭“预测作答”（SPECULATIVE），语义断句仍使用上方 LLM 配置。
QA_PROVIDER=yuxi
# Yuxi 服务地址（QA_PROVIDER=yuxi 时使用）。
YUXI_BASE_URL=http://8.130.55.151:5050
# Yuxi 接口密钥（QA_PROVIDER=yuxi 时必填），泄露后请在 Yuxi 后台作废重建。
YUXI_API_KEY=yxkey_d1173b89d784b387b58642d1cf5ee1dc019f7a6ff7d8642e
# 要调用的 Yuxi 智能体标识（slug），如 wms 表示仓储管理智能体。
YUXI_AGENT_SLUG=wms

# ---------------------------------------------------------------------
# 五、语音识别 ASR
# ---------------------------------------------------------------------
# 百炼实时识别模型。paraformer-realtime-v2 支持热词表和断句静音设置。
ASR_MODEL=paraformer-realtime-v2
# 百炼热词表 ID（在百炼控制台或 API 创建，形如 vocab-xxxx）。
# 强烈建议把“你好超宝”“超宝”及业务术语加进去并给高权重，
# 能明显减少“潮宝/朝宝”之类的错字，也让唤醒复核更容易通过。留空则不使用。
ASR_VOCABULARY_ID=vocab-chaobao-8e378cc192b84e559c3c9ab8a1ed862b
# 百炼 *-v2 实时识别的断句静音时长（毫秒，0~6000，0 表示用服务默认）。
# 用户停顿超过这个时长就判定一句话结束、出最终结果：
# 越小响应越快，但说话中间稍一停顿就可能被截断；越大越不易截断，但等待更久。
ASR_MAX_SENTENCE_SILENCE=500
# 本地 FunASR 热词（仅 PROVIDER=local 生效），格式“词:权重”，多个用英文逗号分隔，
# 例如 超宝:20,你好超宝:30。权重越大越倾向识别成该词。
ASR_HOTWORDS=超宝:20

# ---------------------------------------------------------------------
# 六、语音合成 TTS
# ---------------------------------------------------------------------
# 百炼 CosyVoice 模型。注意音色要与模型版本匹配（v2 模型配 *_v2 音色）。
TTS_MODEL=cosyvoice-v2
# 发音人音色，例如 longxiaochun_v2（龙小淳，知性女声）。
# 可选音色见百炼文档“CosyVoice 音色列表”。
TTS_VOICE=longxiaochun_v2

# ---------------------------------------------------------------------
# 七、本地服务（仅 PROVIDER=local 生效）
# ---------------------------------------------------------------------
# FunASR 官方 2pass WebSocket 服务地址。
LOCAL_ASR_URL=ws://127.0.0.1:10095
# CosyVoice 官方 FastAPI 的 inference_sft 接口地址。
LOCAL_TTS_URL=http://127.0.0.1:50000/inference_sft
# 本地 CosyVoice 的预置说话人名称（需与模型自带说话人一致，如 中文女 / 中文男）。
LOCAL_TTS_VOICE=中文女
# 本地大模型服务的 API Key。多数本地服务不校验，随便填一个非空值即可。
LOCAL_LLM_API_KEY=local

# ---------------------------------------------------------------------
# 八、LiveKit（浏览器与服务端之间的实时音频通道）
# ---------------------------------------------------------------------
# 浏览器连接的 LiveKit 地址。局域网/公网部署时改为浏览器能访问的地址，
# 公网 HTTPS 页面需使用 wss://。
LIVEKIT_URL=ws://127.0.0.1:7880
# 服务端（Node）自己连接 LiveKit 的地址。同机部署与上面相同；
# Docker 部署时可填容器内部地址（如 ws://livekit:7880）。
LIVEKIT_INTERNAL_URL=ws://127.0.0.1:7880
# LiveKit 的 API Key / Secret，必须与 LiveKit 服务端配置一致。
# devkey / secret 是 LiveKit 开发模式（livekit-server --dev）的默认值，生产环境务必修改。
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ---------------------------------------------------------------------
# 九、唤醒
# ---------------------------------------------------------------------
# 唤醒词文字，用于服务端 ASR 复核和界面显示。
# 注意：本地一级唤醒模型按拼音 token 检测，只改这里不会让模型认识新词，
# 换唤醒词还需同步修改 web/src/audio.ts 中的关键词拼音配置。
WAKE_WORD=你好超宝
# 只说唤醒词时的语音应答（逗号分隔可随机多条，如 我在,在呢）；留空则只播提示音。
# 唤醒词后直接接命令（一句话直达）或用户马上开口时不会应答。
WAKE_ACK=我在
# 本地一级唤醒（sherpa-onnx KWS）的触发阈值（0.01~0.9）。
# 越低越容易唤醒，误唤醒也会增多；一级误报会被服务端 ASR 复核过滤。
# 建议 0.1~0.25 之间按真实环境调；唤醒不灵先试 0.1。
KWS_THRESHOLD=0.15
# 唤醒词加权（0.5~5）。越大越偏向识别出唤醒词，建议 1.5~3。
KWS_BOOST=2
# 唤醒链路是否在浏览器自带降噪之上再叠加 RNNoise（true / false）。
# 嘈杂环境叠加有助于抗噪；远场/小声时两层降噪可能削掉语音，唤醒不灵时可设为 false 做 A/B 对比。
KWS_DENOISE=true

# ---------------------------------------------------------------------
# 十、服务端口与访问来源
# ---------------------------------------------------------------------
# Node 服务监听端口。
PORT=3001
# 监听地址。127.0.0.1 只允许本机访问；需要局域网其他设备访问时改为 0.0.0.0。
HOST=127.0.0.1
# 允许访问接口的网页来源（CORS 白名单），英文逗号分隔，需包含协议和端口。
# 用其他域名/IP 打开页面时要加进来，否则会被拒绝。
# ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3001

# ---------------------------------------------------------------------
# 十一、对话体验
# ---------------------------------------------------------------------
# 可选：语义断句模型名（走上方 LLM_BASE_URL 的 OpenAI 兼容接口，如 qwen-turbo）。
# 用于判断用户一句话是否真的说完（比如“我想问一下……”还没说完就不抢答）。
# 留空则只用文本停顿规则判断，延迟更低但更容易在用户停顿时抢话。
# 建议用响应快的小模型，用大模型会增加每轮等待时间。
TURN_MODEL=qwen-turbo
# 预测作答（true / false）。识别结果看起来已说完时提前开始生成回答，
# 若用户随后接着说，则丢弃预生成内容。能降低首句延迟，但会多消耗一些模型调用。
# QA_PROVIDER=yuxi 时自动关闭。
SPECULATIVE=true
# 连续对话窗口（毫秒，1000~30000）。回答结束后这段时间内可直接追问，无需再说唤醒词；
# 主按钮外圈会显示倒计时。
FOLLOWUP_MS=8000
# 没唤醒时也打印开口内容（true / false，默认 true），排查“喊了没醒 / 被听成了什么”。
# 待机时（以及 WAKE_REQUIRED=true 时回答中）有人说话但端侧唤醒没命中，服务端日志会打印
# “[wake] 待机时未唤醒，听到：“…””，含唤醒词或只差一个音节时会注明“端侧唤醒没命中”。
# 只写日志、不触发对话；开启后待机时的说话声也会送去识别，会产生额外识别用量。
WAKE_MISS_LOG=true
# 声纹余弦相似度阈值（0~1），用于唤醒后锁定说话人：追问和免唤醒打断时
# 判断是不是同一个人在说话。越高越严格（别人更难插话，但本人也可能被误拒）；
# 越低越宽松。需按真实设备与环境标定，0.4~0.6 常用。
# 追问时只有足够长（≥1 秒）且明显低于阈值（低于阈值 − 0.15）的话才会被忽略。
SPEAKER_THRESHOLD=0.5

# 备注：字幕/口型使用的字级时间戳均为按文字长度估算，
# 除非接入能返回真实字级对齐的 TTS Provider。
