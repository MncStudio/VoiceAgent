# demo 无需密钥；dashscope 使用百炼；local 使用本地服务。
PROVIDER=demo
DASHSCOPE_API_KEY=
DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# 问答后端独立于语音 Provider；语义断句仍使用上方 LLM 配置。
QA_PROVIDER=openai
YUXI_BASE_URL=http://127.0.0.1:5050
YUXI_API_KEY=
YUXI_AGENT_SLUG=wms
ASR_MODEL=paraformer-realtime-v2
ASR_VOCABULARY_ID=
# 百炼 *-v2 实时识别的断句静音（ms），越小越快出最终结果。
ASR_MAX_SENTENCE_SILENCE=500
# 本地 FunASR 热词，格式“词:权重”，多个用逗号分隔。
ASR_HOTWORDS=超宝:20
TTS_MODEL=cosyvoice-v2
TTS_VOICE=longxiaochun_v2
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_INTERNAL_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
WAKE_WORD=你好超宝
# 只说唤醒词时的语音应答（逗号分隔可随机多条，如 我在,在呢）；留空则只播提示音。
# 唤醒词后直接接命令（一句话直达）或用户马上开口时不会应答。
WAKE_ACK=我在
PORT=3001
HOST=127.0.0.1
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3001
# local 模式：FunASR 官方 2pass websocket / CosyVoice 官方 FastAPI inference_sft。
LOCAL_ASR_URL=ws://127.0.0.1:10095
LOCAL_TTS_URL=http://127.0.0.1:50000/inference_sft
LOCAL_TTS_VOICE=中文女
LOCAL_LLM_API_KEY=local
# 可选：语义断句模型 OpenAI 兼容服务（不设置则使用文本停顿规则）。
TURN_MODEL=
SPECULATIVE=true
FOLLOWUP_MS=8000
# 声纹余弦相似度阈值，需按真实设备与环境标定。
SPEAKER_THRESHOLD=0.5
# 所有时间戳均为估算，除非接入返回真实字级对齐的 TTS Provider。
