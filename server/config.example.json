{
  "_说明": "这是配置模板(可提交到 git)。复制为 server/config/local.json 或 server/config/online.json 后填写真实值,这两个文件已被 gitignore 排除。",
  "profile": "local",
  "server": {
    "port": 3000,
    "tmpDir": "/tmp/voiceagent"
  },
  "asr": {
    "provider": "paraformer-http | paraformer-ws",
    "url": "http://<asr-host>:50001",
    "endpoint": "/api/v1/asr_stream_file",
    "apiKey": "",
    "dashScopeBase": "",
    "model": "",
    "timeoutMs": 30000
  },
  "llm": {
    "provider": "yuxi | openai-compatible",
    "url": "http://<llm-host>:5050",
    "baseUrl": "",
    "model": "",
    "apiKey": "",
    "agentSlug": "",
    "agentId": "",
    "pollIntervalMs": 1000,
    "pollTimeoutMs": 90000,
    "requestTimeoutMs": 30000
  },
  "tts": {
    "provider": "cosyvoice-http | cosyvoice-ws",
    "url": "http://<tts-host>:50002",
    "endpoint": "/inference_zero_shot",
    "apiKey": "",
    "dashScopeBase": "",
    "model": "",
    "voice": "",
    "spkId": "",
    "sampleRate": 24000,
    "channels": 1,
    "bitsPerSample": 16,
    "timeoutMs": 60000
  }
}
