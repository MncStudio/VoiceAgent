{
  "name": "chaobao-voice-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n agent,web \"npm:dev:server\" \"npm:dev:web\"",
    "predev:server": "npm run build:sdk",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && npm run build:sdk && tsup server/index.ts --format esm --platform node --out-dir dist/server --external @livekit/rtc-node",
    "start": "node dist/server/index.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "setup:assets": "node scripts/setup-assets.mjs",
    "setup:livekit": "node scripts/setup-livekit.mjs",
    "livekit": "node scripts/run-livekit.mjs",
    "doctor": "tsx scripts/doctor.ts",
    "build:sdk": "vite build --config vite.sdk.config.ts && node -e \"require('node:fs').copyFileSync('sdk/chaobao-sdk.d.ts','dist/sdk/chaobao-sdk.d.ts')\""
  },
  "dependencies": {
    "@livekit/rtc-node": "^0.13.0",
    "@pixiv/three-vrm": "^3.4.4",
    "@ricky0123/vad-web": "^0.0.31",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "fft.js": "^4.0.4",
    "https-proxy-agent": "^7.0.6",
    "livekit-client": "^2.15.0",
    "livekit-server-sdk": "^2.13.3",
    "onnxruntime-web": "^1.22.0",
    "pinyin-pro": "^3.29.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "undici": "^7.30.0",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^3.2.4"
  }
}
