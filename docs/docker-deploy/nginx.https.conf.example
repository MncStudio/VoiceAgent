# 放在同一台宿主机的 Nginx http 配置下。
# 替换两个域名、证书路径；证书须被用户浏览器信任。
map $http_upgrade $employee_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 443 ssl;
    server_name employee.example.com;
    ssl_certificate /etc/nginx/ssl/employee/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/employee/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $employee_connection_upgrade;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

server {
    listen 443 ssl;
    server_name rtc.example.com;
    ssl_certificate /etc/nginx/ssl/rtc/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/rtc/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:7880;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $employee_connection_upgrade;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
    }
}
